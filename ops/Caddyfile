# Caddy reverse proxy for Pulse.
# Replace pulse.example.org with your domain; Caddy fetches and renews the
# Let's Encrypt certificate automatically.

pulse.example.org {
	# metrics stay private: Prometheus scrapes localhost:7070 directly
	@metrics path /metrics
	respond @metrics 403

	reverse_proxy localhost:7070

	encode gzip

	log {
		output stdout
		format json
	}
}
